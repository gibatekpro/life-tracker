# Copy to .env (git-ignored) and fill in your Mac's Tailscale IP (Tailscale menu → This device,
# or `tailscale ip -4`). EXPO_PUBLIC_ values are bundled into the app's JavaScript, so nothing
# secret goes here: the API key is pasted into the app's Settings and kept in the iOS Keychain.
EXPO_PUBLIC_API_URL=http://<mac-tailscale-ip>:5080
